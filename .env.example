# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Stripe (Dashboard > Developers > API keys). Usa claves de PRUEBA (sk_test_...) hasta lanzar.
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks > endpoint /api/stripe/webhook  (o `stripe listen` en local)
STRIPE_WEBHOOK_SECRET=
DB_PATH=./contratoya.db
